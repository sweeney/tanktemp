[Unit]
Description=tanktemp: DS18B20 hot water cylinder probes to MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tanktemp/tanktemp-bin -config /etc/tanktemp/config.yaml
Restart=on-failure
RestartSec=5
# A sweep in progress stops within one 1-Wire read (<1 s); then SHUTDOWN is
# published.
TimeoutStopSec=10

# Runs as its own system user (setup-pi.sh makes it), from /opt/tanktemp,
# where the deploy user's builds are (mode 0755). It only reads sysfs (the
# 1-Wire files are world-readable) and its config (root:tanktemp 0640),
# publishes to MQTT and serves HTTP on port 80.
User=tanktemp
Group=tanktemp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=64M

[Install]
WantedBy=multi-user.target
