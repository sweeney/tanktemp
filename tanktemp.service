[Unit]
Description=tanktemp: DS18B20 hot water cylinder probes to MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tanktemp/tanktemp-bin -config /etc/tanktemp/config.yaml
Restart=on-failure
RestartSec=5
# A sweep in progress stops within one 1-Wire read (<1 s); then SHUTDOWN is
# published.
TimeoutStopSec=10

# Runs as its own system user (setup-pi.sh makes it), from /opt/tanktemp,
# where the deploy user's builds are (mode 0755). It reads sysfs (the
# 1-Wire files are world-readable) and its config (root:tanktemp 0640),
# reads the water meter's GPIO line, publishes to MQTT and serves HTTP on
# port 80.
User=tanktemp
Group=tanktemp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
# The water meter's GPIO line (docs/WIRE.md, Meter). PrivateDevices=true
# would hide /dev/gpiochip*, so instead: no device but the standard
# pseudo-devices (closed), plus the GPIO chips, read-only, and their group
# (gpio, as Raspberry Pi OS makes them root:gpio 0660). Read-only is
# enough: go-gpiocdev opens the chip O_RDONLY, and a line request is an
# ioctl that returns a new descriptor, which the device policy (it checks
# open()) doesn't see. Without a meter configured
# none of them is opened. PrivateDevices=true also implied the @raw-io
# system call filter, kept here, and dropping CAP_SYS_RAWIO and CAP_MKNOD,
# which CapabilityBoundingSet above already does (systemd.exec(5)). Two
# more are extra, not from it: no foreign architectures, and the host's
# /dev/shm hidden (tanktemp never uses it). systemd-analyze security on the
# rig, 2026-11-20: 3.6, against the old unit's 3.7 (without these three
# lines, 4.0).
DevicePolicy=closed
DeviceAllow=char-gpiochip r
SupplementaryGroups=gpio
SystemCallFilter=~@raw-io
SystemCallArchitectures=native
InaccessiblePaths=-/dev/shm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=64M

[Install]
WantedBy=multi-user.target
